#!/usr/bin/python3
# Escritório Pixel: abre o escritório numa janela própria.
# Liga o cérebro (Node) numa porta livre, mostra a tela numa janela GTK com
# WebKit e, ao fechar a janela, desliga o cérebro e os funcionários.

import ctypes
import os
import shutil
import signal
import socket
import subprocess
import sys
import urllib.request

import gi

gi.require_version('Gtk', '4.0')
gi.require_version('WebKit', '6.0')
from gi.repository import Gio, GLib, Gtk, WebKit  # noqa: E402

APP_ID = 'io.github.cronistc.EscritorioPixel'
PASTA_APP = os.environ.get('ESCRITORIO_APP', '/usr/lib/escritorio-pixel')
DADOS = os.path.join(os.environ.get('XDG_DATA_HOME') or os.path.expanduser('~/.local/share'), 'escritorio-pixel')
CACHE = os.path.join(os.environ.get('XDG_CACHE_HOME') or os.path.expanduser('~/.cache'), 'escritorio-pixel')
NODE_MINIMO = 18


def morrer_junto():
    # Se a janela morrer de qualquer jeito (até travando), o kernel avisa o
    # cérebro com SIGTERM: nada fica rodando escondido.
    ctypes.CDLL('libc.so.6', use_errno=True).prctl(1, signal.SIGTERM)  # PR_SET_PDEATHSIG


def porta_livre():
    with socket.socket() as s:
        s.bind(('127.0.0.1', 0))
        return s.getsockname()[1]


def versao_node(node):
    try:
        v = subprocess.run([node, '-v'], capture_output=True, text=True, timeout=10).stdout.strip()
        return int(v.lstrip('v').split('.')[0])
    except Exception:
        return 0


class Escritorio(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.janela = None
        self.cerebro = None
        self.porta = None
        self.tentativas = 0

    # ---------- janela ----------
    def do_activate(self):
        if self.janela:
            self.janela.present()
            return
        self.janela = Gtk.ApplicationWindow(application=self, title='Escritório Pixel')
        self.janela.set_default_size(1440, 900)
        self.janela.connect('close-request', self.ao_fechar)
        self.aviso = Gtk.Label(label='Abrindo o escritório…')
        self.aviso.set_wrap(True)
        self.aviso.set_selectable(True)
        self.aviso.set_margin_start(32)
        self.aviso.set_margin_end(32)
        self.janela.set_child(self.aviso)
        self.janela.present()
        self.ligar_cerebro()

    def mostrar_erro(self, texto):
        self.aviso.set_markup(f'<b>Não consegui abrir o escritório.</b>\n\n{GLib.markup_escape_text(texto)}')
        self.janela.set_child(self.aviso)

    # ---------- cérebro ----------
    def ligar_cerebro(self):
        node = shutil.which('node')
        if not node or versao_node(node) < NODE_MINIMO:
            return self.mostrar_erro(f'Precisa do Node.js {NODE_MINIMO} ou mais novo. Instale com: sudo dnf install nodejs')
        os.makedirs(DADOS, exist_ok=True)
        self.porta = porta_livre()
        env = dict(os.environ, PORTA=str(self.porta), PASTA_LOGS=os.path.join(DADOS, 'logs'))
        self.log = open(os.path.join(DADOS, 'cerebro.log'), 'w')
        self.cerebro = subprocess.Popen(
            [node, os.path.join(PASTA_APP, 'dist', 'servidor.js')],
            cwd=DADOS, env=env, stdout=self.log, stderr=subprocess.STDOUT,
            start_new_session=True,  # grupo próprio: dá para desligar tudo de uma vez
            preexec_fn=morrer_junto,
        )
        GLib.timeout_add(200, self.esperar_cerebro)

    def esperar_cerebro(self):
        if self.cerebro.poll() is not None:
            self.log.flush()
            with open(self.log.name) as f:
                fim = f.read()[-1500:]
            self.mostrar_erro(f'O cérebro parou (código {self.cerebro.returncode}).\n\n{fim}')
            return False
        try:
            urllib.request.urlopen(f'http://127.0.0.1:{self.porta}/config', timeout=1).read()
        except Exception:
            self.tentativas += 1
            if self.tentativas > 150:
                self.mostrar_erro('O cérebro não respondeu em 30 segundos. Veja ' + self.log.name)
                return False
            return True
        self.abrir_tela()
        return False

    def abrir_tela(self):
        os.makedirs(CACHE, exist_ok=True)
        sessao = WebKit.NetworkSession.new(os.path.join(DADOS, 'web'), os.path.join(CACHE, 'web'))
        self.web = WebKit.WebView(network_session=sessao)
        self.web.connect('decide-policy', self.decidir)
        self.web.load_uri(f'http://127.0.0.1:{self.porta}/')
        self.janela.set_child(self.web)

    def decidir(self, _web, decisao, tipo):
        # Links externos (login, documentação) abrem no navegador do sistema.
        if tipo in (WebKit.PolicyDecisionType.NAVIGATION_ACTION, WebKit.PolicyDecisionType.NEW_WINDOW_ACTION):
            uri = decisao.get_navigation_action().get_request().get_uri()
            if not uri.startswith(f'http://127.0.0.1:{self.porta}'):
                Gio.AppInfo.launch_default_for_uri(uri, None)
                decisao.ignore()
                return True
        return False

    # ---------- fim do expediente ----------
    def desligar(self):
        if not self.cerebro or self.cerebro.poll() is not None:
            return
        try:
            os.killpg(self.cerebro.pid, signal.SIGTERM)
            self.cerebro.wait(timeout=5)
        except subprocess.TimeoutExpired:
            os.killpg(self.cerebro.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass

    def ao_fechar(self, _janela):
        self.desligar()
        return False

    def do_shutdown(self):
        self.desligar()
        Gtk.Application.do_shutdown(self)


if __name__ == '__main__':
    app = Escritorio()
    for sinal in (signal.SIGINT, signal.SIGTERM):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sinal, app.quit)
    sys.exit(app.run(sys.argv))
